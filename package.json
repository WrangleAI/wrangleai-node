{
  "name": "wrangleai",
  "version": "0.0.6",
  "description": "Official Node.js client for Wrangle AI - OpenAI-compatible SDK with retry, logging, and abort support",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "prepublishOnly": "npm run build",
    "lint": "echo 'Linting not configured yet'",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WrangleAI/wrangleai-node.git"
  },
  "keywords": [
    "wrangleai",
    "ai",
    "smart-routing",
    "llm",
    "sdk",
    "rag",
    "vector-store"
  ],
  "author": "WrangleAI",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/WrangleAI/wrangleai-node/issues"
  },
  "homepage": "https://github.com/WrangleAI/wrangleai-node#readme",
  "dependencies": {
    "axios": "^1.13.2",
    "form-data": "^4.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^24.10.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "minimatch": "^10.0.1",
    "glob": "^11.0.0"
  }
}
